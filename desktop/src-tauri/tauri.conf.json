{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TabDisplay",
  "version": "0.1.0",
  "identifier": "com.tabdisplay.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TabDisplay",
        "width": 460,
        "height": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/adb/*": "adb/",
      "resources/vdd/*": "vdd/",
      "resources/tabdisplay.apk": "tabdisplay.apk"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  },
  "mainBinaryName": "tabdisplay"
}